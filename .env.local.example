# Copy to .env.local to run this app against real Voult staging instead of the fake (npm run dev).
# .env.local overrides .env. Add http://localhost:3100/api/auth/oauth/callback under Callback URLs.
VOULT_BASE_URL=https://staging.voult.dev
VOULT_CLIENT_ID=
VOULT_CLIENT_SECRET=
VOULT_SESSION_SECRET=
